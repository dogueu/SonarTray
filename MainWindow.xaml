<Window x:Class="SonarTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SonarTray"
        Width="460"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Deactivated="Window_Deactivated"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <SolidColorBrush x:Key="WindowBgBrush" Color="#18181B" />
        <SolidColorBrush x:Key="CardBgBrush" Color="#222227" />
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#3F3F46" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF5500" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TrackBrush" Color="#3F3F46" />

        <!-- Transparent hit-area RepeatButton for Horizontal Sliders -->
        <Style x:Key="HorizontalRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="20" VerticalAlignment="Center">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Transparent hit-area RepeatButton for Vertical EQ Sliders -->
        <Style x:Key="VerticalRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Width="22" HorizontalAlignment="Center">
                            <Border Width="4"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Background}"
                                    HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Thumb -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="#F4F4F5" Stroke="#18181B" StrokeThickness="1.5" />
                            <Ellipse x:Name="InnerDot"
                                     Width="6"
                                     Height="6"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InnerDot" Property="Width" Value="8" />
                                <Setter TargetName="InnerDot" Property="Height" Value="8" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="InnerDot" Property="Width" Value="9" />
                                <Setter TargetName="InnerDot" Property="Height" Value="9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Horizontal Accent Slider -->
        <Style x:Key="HorizontalAccentSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource HorizontalRepeatButtonStyle}"
                                                  Command="{x:Static Slider.DecreaseLarge}"
                                                  Background="{TemplateBinding Foreground}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource HorizontalRepeatButtonStyle}"
                                                  Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="{StaticResource TrackBrush}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Channel Volume Slider (dims when muted) -->
        <Style x:Key="VolumeSliderStyle" TargetType="Slider" BasedOn="{StaticResource HorizontalAccentSliderStyle}">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.01" />
            <Setter Property="LargeChange" Value="0.05" />
            <Setter Property="TickFrequency" Value="0.01" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter Property="Foreground" Value="#71717A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ChatMix Centered Slider -->
        <Style x:Key="ChatMixSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Minimum" Value="-1" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="SmallChange" Value="0.02" />
            <Setter Property="LargeChange" Value="0.1" />
            <Setter Property="TickFrequency" Value="0.01" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource TrackBrush}" VerticalAlignment="Center" />
                            <Border Width="2" Height="10" CornerRadius="1" Background="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource HorizontalRepeatButtonStyle}"
                                                  Command="{x:Static Slider.DecreaseLarge}"
                                                  Background="Transparent" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource HorizontalRepeatButtonStyle}"
                                                  Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#71717A" />
                    <Setter Property="Opacity" Value="0.38" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Vertical EQ Band Slider -->
        <Style x:Key="VerticalEqSliderStyle" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Minimum" Value="-12" />
            <Setter Property="Maximum" Value="12" />
            <Setter Property="SmallChange" Value="0.5" />
            <Setter Property="LargeChange" Value="1" />
            <Setter Property="TickFrequency" Value="0.1" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Height" Value="132" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Width="24" HorizontalAlignment="Center">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource TrackBrush}" HorizontalAlignment="Center" />
                            <Border Height="2" Width="10" CornerRadius="1" Background="#71717A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VerticalRepeatButtonStyle}"
                                                  Command="{x:Static Slider.DecreaseLarge}"
                                                  Background="Transparent" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource VerticalRepeatButtonStyle}"
                                                  Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Foreground" Value="#71717A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Small Header Icon Button -->
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#52525B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pin ToggleButton -->
        <Style x:Key="HeaderPinButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#431E0E" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5500" />
                                <Setter Property="Foreground" Value="#FF7A33" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Pill Button -->
        <Style x:Key="ActionChipButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2A2A31" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A44" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5500" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B4B57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small Reset-to-Default Icon Button -->
        <Style x:Key="ResetIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#2A2A31" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Path Width="11"
                                  Height="11"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Data="M 5,11 A 8,8 0 1 0 7.5,5.5 M 5,2.5 L 5,6.5 L 9,6.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A44" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5500" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4B4B57" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab / Channel RadioButton -->
        <Style x:Key="SegmentedRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D35" />
                                <Setter Property="Foreground" Value="#F4F4F5" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF5500" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Switch CheckBox -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track"
                                    Width="32"
                                    Height="17"
                                    CornerRadius="8.5"
                                    Background="#3F3F46"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob"
                                         Width="13"
                                         Height="13"
                                         Fill="#F4F4F5"
                                         HorizontalAlignment="Left" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#FF5500" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small EQ Band Enable CheckBox -->
        <Style x:Key="SmallCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="14"
                                Height="14"
                                CornerRadius="3"
                                Background="#27272A"
                                BorderBrush="#52525B"
                                BorderThickness="1">
                            <Path x:Name="Check"
                                  Visibility="Collapsed"
                                  Stroke="#FFFFFF"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 3,7 L 5.8,9.8 L 11,4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#FF5500" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#FF5500" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox & Item Style -->
        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32323B" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A2411" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E4E4E7" />
            <Setter Property="Background" Value="#1B1B20" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0,22,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="#1B1B20"
                                                BorderBrush="#3F3F46"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Path Width="8"
                                                  Height="5"
                                                  Margin="0,0,8,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Stroke="#A1A1AA"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Data="M 1,1 L 4,4 L 7,1" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#52525B" />
                                                <Setter TargetName="Bd" Property="Background" Value="#25252C" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Border ClipToBounds="True" Margin="8,0,22,0" VerticalAlignment="Center">
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                            </Border>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260">
                                    <Border Background="#1F1F25"
                                            BorderBrush="#3F3F46"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,3,0,0"
                                            Padding="2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark TextBox -->
        <Style x:Key="DarkTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#1B1B20" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="CaretBrush" Value="#FF5500" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Height" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5500" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Mute Button Style -->
        <Style x:Key="MuteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#323236" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid Width="14" Height="14">
                                <Path x:Name="SpeakerOn"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Data="M 2,8 L 5.5,8 L 10,4 L 10,18 L 5.5,14 L 2,14 Z M 13.5,7.5 C 15,9 15,13 13.5,14.5 M 16,5 C 18.5,8 18.5,14 16,17" />
                                <Path x:Name="SpeakerOff"
                                      Visibility="Collapsed"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Data="M 2,8 L 5.5,8 L 10,4 L 10,18 L 5.5,14 L 2,14 Z M 13.5,8.5 L 18.5,13.5 M 18.5,8.5 L 13.5,13.5" />
                                <Path x:Name="MicOn"
                                      Visibility="Collapsed"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Data="M 9,2 C 7.3,2 6,3.3 6,5 L 6,10 C 6,11.7 7.3,13 9,13 C 10.7,13 12,11.7 12,10 L 12,5 C 12,3.3 10.7,2 9,2 Z M 3.5,10 C 3.5,13 6,15.5 9,15.5 C 12,15.5 14.5,13 14.5,10 M 9,15.5 L 9,19 M 6.5,19 L 11.5,19" />
                                <Path x:Name="MicOff"
                                      Visibility="Collapsed"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Data="M 9,2 C 7.3,2 6,3.3 6,5 L 6,10 C 6,11.7 7.3,13 9,13 C 10.7,13 12,11.7 12,10 L 12,5 C 12,3.3 10.7,2 9,2 Z M 3.5,10 C 3.5,13 6,15.5 9,15.5 C 12,15.5 14.5,13 14.5,10 M 9,15.5 L 9,19 M 3,3 L 15,17" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F3F46" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsMic}" Value="True">
                                <Setter TargetName="SpeakerOn" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MicOn" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Muted}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3F1D1D" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7F1D1D" />
                                <Setter Property="Foreground" Value="#F87171" />
                                <Setter TargetName="SpeakerOn" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MicOn" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="SpeakerOff" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMic}" Value="True" />
                                    <Condition Binding="{Binding Muted}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="SpeakerOff" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="MicOff" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Shared White Vector Sonar Logo -->
        <ControlTemplate x:Key="SonarLogoTemplate" TargetType="Control">
            <Viewbox Stretch="Uniform">
                <Canvas Width="64" Height="64">
                    <Ellipse Canvas.Left="27.8" Canvas.Top="27.8" Width="8.4" Height="8.4" Fill="#FFFFFF" />
                    <Path Stroke="#FFFFFF" StrokeThickness="4.8" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                          Data="M 21.2,32 A 10.8,10.8 0 0 1 32,21.2" />
                    <Path Stroke="#FFFFFF" StrokeThickness="4.8" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                          Data="M 42.8,32 A 10.8,10.8 0 0 1 32,42.8" />
                    <Path Stroke="#FFFFFF" StrokeThickness="4.8" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                          Data="M 12,32 A 20,20 0 0 1 38.84,13.21" />
                    <Path Stroke="#FFFFFF" StrokeThickness="4.8" StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                          Data="M 52,32 A 20,20 0 0 1 25.16,50.79" />
                </Canvas>
            </Viewbox>
        </ControlTemplate>
    </Window.Resources>

    <Border Background="{StaticResource WindowBgBrush}"
            BorderBrush="{StaticResource BorderBrushSubtle}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22"
                                Height="22"
                                CornerRadius="5.5"
                                Background="#FF5500"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                            <Control Template="{StaticResource SonarLogoTemplate}" Focusable="False" />
                        </Border>
                        <TextBlock Text="SonarTray"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="StatusDot"
                                 Grid.Column="0"
                                 Width="7"
                                 Height="7"
                                 Fill="#F59E0B"
                                 VerticalAlignment="Top"
                                 Margin="0,4,6,0" />
                        <TextBlock x:Name="StatusText"
                                   Grid.Column="1"
                                   Text="{DynamicResource Str_StatusConnecting}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <ToggleButton x:Name="SettingsButton"
                                  Style="{StaticResource HeaderPinButtonStyle}"
                                  ToolTip="{DynamicResource Str_SettingsTooltip}"
                                  Checked="SettingsButton_Changed"
                                  Unchecked="SettingsButton_Changed"
                                  Margin="0,0,6,0">
                        <Path Width="13.5"
                              Height="13.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Data="M 12,8.5 A 3.5,3.5 0 1 0 12,15.5 A 3.5,3.5 0 1 0 12,8.5 M 19.4,15 A 1.65,1.65 0 0 0 19.73,16.82 L 19.79,16.88 A 2,2 0 1 1 16.96,19.71 L 16.9,19.65 A 1.65,1.65 0 0 0 15.08,19.32 A 1.65,1.65 0 0 0 14,20.91 V 21 A 2,2 0 1 1 10,21 V 20.91 A 1.65,1.65 0 0 0 8.92,19.4 A 1.65,1.65 0 0 0 7.1,19.73 L 7.04,19.79 A 2,2 0 1 1 4.21,16.96 L 4.27,16.9 A 1.65,1.65 0 0 0 4.6,15.08 A 1.65,1.65 0 0 0 3,14 H 2.91 A 2,2 0 1 1 2.91,10 H 3 A 1.65,1.65 0 0 0 4.51,8.92 A 1.65,1.65 0 0 0 4.18,7.1 L 4.12,7.04 A 2,2 0 1 1 6.95,4.21 L 7.01,4.27 A 1.65,1.65 0 0 0 8.83,4.6 H 8.91 A 1.65,1.65 0 0 0 10,3.09 V 3 A 2,2 0 1 1 14,3 V 3.09 A 1.65,1.65 0 0 0 15,4.6 A 1.65,1.65 0 0 0 16.82,4.27 L 16.88,4.21 A 2,2 0 1 1 19.71,7.04 L 19.65,7.1 A 1.65,1.65 0 0 0 19.32,8.92 V 9 A 1.65,1.65 0 0 0 20.91,10 H 21 A 2,2 0 1 1 21,14 H 20.91 A 1.65,1.65 0 0 0 19.4,15 Z" />
                    </ToggleButton>

                    <ToggleButton x:Name="PinButton"
                                  Style="{StaticResource HeaderPinButtonStyle}"
                                  ToolTip="{DynamicResource Str_PinTooltip}"
                                  Checked="PinButton_Changed"
                                  Unchecked="PinButton_Changed"
                                  Margin="0,0,6,0">
                        <Path Width="13"
                              Height="13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              Data="M 9,2 L 15,2 L 14,8 L 17,11 L 7,11 L 10,8 Z M 12,11 L 12,19" />
                    </ToggleButton>

                    <Button x:Name="RefreshButton"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="{DynamicResource Str_RefreshTooltip}"
                            Click="RefreshButton_Click">
                        <Path Width="13"
                              Height="13"
                              Stroke="{StaticResource TextPrimaryBrush}"
                              StrokeThickness="1.7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              Data="M 19,11 A 8,8 0 1 1 16.5,5.5 M 19,2.5 L 19,6.5 L 15,6.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 3-Tab Navigation Bar -->
            <Border x:Name="MainTabNavBorder"
                    Grid.Row="1"
                    Background="#222227"
                    BorderBrush="#323238"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="3"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="TabMixerBtn"
                                 Grid.Column="0"
                                 GroupName="MainTabGroup"
                                 Content="{DynamicResource Str_TabMixer}"
                                 Style="{StaticResource SegmentedRadioStyle}"
                                 IsChecked="True"
                                 Checked="MainTab_Checked" />
                    <RadioButton x:Name="TabEqBtn"
                                 Grid.Column="1"
                                 GroupName="MainTabGroup"
                                 Content="{DynamicResource Str_TabEq}"
                                 Style="{StaticResource SegmentedRadioStyle}"
                                 Checked="MainTab_Checked" />
                    <RadioButton x:Name="TabDspBtn"
                                 Grid.Column="2"
                                 GroupName="MainTabGroup"
                                 Content="{DynamicResource Str_TabDsp}"
                                 Style="{StaticResource SegmentedRadioStyle}"
                                 Checked="MainTab_Checked" />
                </Grid>
            </Border>

            <!-- Scrollable Tab Body -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- TAB 1: MIXER & DEVICES -->
                    <StackPanel x:Name="MixerTabPanel">
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,6">
                            <ItemsControl x:Name="ChannelsItemsControl" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#2D2D34"
                                                BorderThickness="0,0,0,1"
                                                Padding="0,5">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center" />

                                                    <CheckBox Grid.Column="1"
                                                              Style="{StaticResource ToggleSwitchStyle}"
                                                              Visibility="{Binding ToggleChannelVisibility}"
                                                              IsChecked="{Binding IsChannelEnabled, Mode=TwoWay}"
                                                              Click="ChannelEnableToggle_Click"
                                                              ToolTip="{DynamicResource Str_ToggleChannelTooltip}"
                                                              Margin="0,0,8,0" />

                                                    <Grid Grid.Column="2" Visibility="{Binding ActiveControlsVisibility}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="30" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <Button Grid.Column="0"
                                                                Style="{StaticResource MuteButtonStyle}"
                                                                ToolTip="{DynamicResource Str_MuteTooltip}"
                                                                Click="MuteButton_Click"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center" />

                                                        <Slider Grid.Column="1"
                                                                Style="{StaticResource VolumeSliderStyle}"
                                                                Value="{Binding Volume, Mode=TwoWay}"
                                                                ValueChanged="ChannelSlider_ValueChanged"
                                                                Margin="4,0" />

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding VolumePercentText}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   TextAlignment="Right" />

                                                        <Button Grid.Column="3"
                                                                Content="EQ"
                                                                Style="{StaticResource ActionChipButtonStyle}"
                                                                Visibility="{Binding HasAdvancedSettings, Converter={StaticResource BoolToVis}}"
                                                                ToolTip="{DynamicResource Str_OpenChannelEqTooltip}"
                                                                Click="OpenChannelEq_Click"
                                                                Margin="6,0,0,0"
                                                                Padding="7,2" />
                                                    </Grid>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{DynamicResource Str_ChannelDisabled}"
                                                               FontSize="11"
                                                               Foreground="#71717A"
                                                               Visibility="{Binding DisabledBadgeVisibility}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Device, Preset & Reset-to-Default Row (hidden for Master or disabled channels) -->
                                                <Grid Visibility="{Binding AdvancedControlsVisibility}"
                                                      Margin="0,5,0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="6" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="5" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Grid.Column="0"
                                                              Style="{StaticResource DarkComboBoxStyle}"
                                                              ItemsSource="{Binding AvailableDevices}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="FriendlyName"
                                                              SelectedValue="{Binding SelectedDeviceId, Mode=OneWay}"
                                                              SelectionChanged="ChannelDeviceCombo_SelectionChanged"
                                                              DropDownOpened="ComboBox_DropDownOpened"
                                                              DropDownClosed="ComboBox_DropDownClosed"
                                                              ToolTip="{DynamicResource Str_SelectDeviceTooltip}" />

                                                    <ComboBox Grid.Column="2"
                                                              Style="{StaticResource DarkComboBoxStyle}"
                                                              ItemsSource="{Binding AvailableConfigs}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="Name"
                                                              SelectedValue="{Binding SelectedConfigId, Mode=OneWay}"
                                                              SelectionChanged="ChannelPresetCombo_SelectionChanged"
                                                              DropDownOpened="ComboBox_DropDownOpened"
                                                              DropDownClosed="ComboBox_DropDownClosed"
                                                              ToolTip="{DynamicResource Str_SelectPresetTooltip}" />

                                                    <Button Grid.Column="4"
                                                            Style="{StaticResource ResetIconButtonStyle}"
                                                            ToolTip="{DynamicResource Str_ResetPresetTooltip}"
                                                            Click="ResetChannelProfile_Click" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Quick Sync Devices Action -->
                        <Button x:Name="SyncRenderDevicesButton"
                                Content="{DynamicResource Str_SyncOutputsBtn}"
                                Style="{StaticResource ActionChipButtonStyle}"
                                Click="SyncRenderDevicesButton_Click"
                                HorizontalAlignment="Stretch"
                                Margin="0,8,0,0"
                                Padding="10,6" />

                        <!-- ChatMix -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="ChatMix"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="ChatMixStatusText"
                                               Text="{DynamicResource Str_ChatMixBalanced}"
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="#FF7A33"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Slider x:Name="ChatMixSlider"
                                        Style="{StaticResource ChatMixSliderStyle}"
                                        Value="0"
                                        ToolTip="{DynamicResource Str_ChatMixDoubleClickResetTooltip}"
                                        ValueChanged="ChatMixSlider_ValueChanged"
                                        PreviewMouseLeftButtonDown="ChatMixSlider_PreviewMouseLeftButtonDown" />

                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Game"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Left" />
                                    <TextBlock x:Name="ChatMixFooterHintText"
                                               Text="{DynamicResource Str_ChatMixFooterReset}"
                                               FontSize="10"
                                               Foreground="#71717A"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="Chat"
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               HorizontalAlignment="Right" />
                                </Grid>

                                <Border x:Name="ChatMixDisabledBanner"
                                        Visibility="Collapsed"
                                        Background="#1B1B20"
                                        BorderBrush="#323238"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="0,6,0,0">
                                    <TextBlock x:Name="ChatMixDisabledReasonText"
                                               Text="{DynamicResource Str_ChatMixReasonHardware}"
                                               FontSize="10.5"
                                               Foreground="#A1A1AA"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: 10-BAND PARAMETRIC EQ -->
                    <StackPanel x:Name="EqTabPanel" Visibility="Collapsed">
                        <!-- Channel Selector -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Margin="0,0,0,8">
                            <UniformGrid x:Name="EqChannelSelectorGrid" Rows="1">
                                <RadioButton GroupName="EqChannelGroup" Content="Game" Tag="game" Style="{StaticResource SegmentedRadioStyle}" IsChecked="True" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="EqChannelGroup" Content="Chat" Tag="chatRender" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="EqChannelGroup" Content="Media" Tag="media" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="EqChannelGroup" Content="Aux" Tag="aux" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="EqChannelGroup" Content="Mic" Tag="chatCapture" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                            </UniformGrid>
                        </Border>

                        <!-- EQ Controls Card -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox x:Name="EqPresetCombo"
                                              Grid.Column="0"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectionChanged="EqPresetCombo_SelectionChanged"
                                              DropDownOpened="ComboBox_DropDownOpened"
                                              DropDownClosed="ComboBox_DropDownClosed"
                                              Margin="0,0,8,0" />

                                    <CheckBox x:Name="EqEnabledToggle"
                                              Grid.Column="1"
                                              Content="{DynamicResource Str_EqEnabled}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Click="EqEnabledToggle_Click"
                                              Margin="0,0,8,0" />

                                    <Button x:Name="EqFlattenButton"
                                            Grid.Column="2"
                                            Content="{DynamicResource Str_EqFlattenBtn}"
                                            Style="{StaticResource ActionChipButtonStyle}"
                                            ToolTip="{DynamicResource Str_EqFlattenTooltip}"
                                            Click="EqFlattenButton_Click"
                                            Margin="0,0,6,0" />

                                    <Button x:Name="EqResetDefaultButton"
                                            Grid.Column="3"
                                            Style="{StaticResource ResetIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_EqResetTooltip}"
                                            Click="EqResetDefaultButton_Click" />
                                </Grid>

                                <!-- 10 Vertical EQ Sliders -->
                                <ItemsControl x:Name="EqBandsItemsControl" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding SelectionBgBrush}"
                                                    BorderBrush="{Binding SelectionBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="1,4"
                                                    Margin="1,0"
                                                    PreviewMouseLeftButtonDown="EqBandCard_MouseDown">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding GainText}"
                                                               FontSize="9.5"
                                                               Foreground="#D4D4D8"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,3" />
                                                    <Slider Style="{StaticResource VerticalEqSliderStyle}"
                                                            Value="{Binding Gain, Mode=TwoWay}"
                                                            ToolTip="{DynamicResource Str_EqBandSliderTooltip}"
                                                            ValueChanged="EqBandSlider_ValueChanged"
                                                            PreviewMouseLeftButtonDown="EqBandSlider_PreviewMouseLeftButtonDown" />
                                                    <CheckBox Style="{StaticResource SmallCheckBoxStyle}"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                              Click="EqBandEnable_Click"
                                                              HorizontalAlignment="Center"
                                                              Margin="0,4,0,3" />
                                                    <TextBlock Text="{Binding FrequencyShortText}"
                                                               FontSize="9.5"
                                                               Foreground="#A1A1AA"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Selected Band Fine-Tuning Inspector -->
                        <Border x:Name="EqInspectorCard"
                                Visibility="Collapsed"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="SelectedBandTitleText"
                                               Text="Bant #1 İnce Ayarı"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#FF7A33"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left" />
                                    <Button Content="✕"
                                            Width="20"
                                            Height="20"
                                            Padding="0"
                                            FontSize="10"
                                            Style="{StaticResource HeaderIconButtonStyle}"
                                            Click="CloseBandInspector_Click"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="1.25*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{DynamicResource Str_EqFrequencyHz}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <TextBox x:Name="EqBandFreqBox"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 KeyDown="EqInspectorBox_KeyDown"
                                                 LostFocus="EqInspectorBox_LostFocus" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Str_EqQFactor}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <TextBox x:Name="EqBandQBox"
                                                 Style="{StaticResource DarkTextBoxStyle}"
                                                 KeyDown="EqInspectorBox_KeyDown"
                                                 LostFocus="EqInspectorBox_LostFocus" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="{DynamicResource Str_EqFilterType}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                        <ComboBox x:Name="EqBandTypeCombo"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="EqBandTypeCombo_SelectionChanged"
                                                  DropDownOpened="ComboBox_DropDownOpened"
                                                  DropDownClosed="ComboBox_DropDownClosed">
                                            <ComboBoxItem x:Name="FilterPeakingItem" Content="Tepe / Çukur (Peaking)" Tag="peakingEQ" />
                                            <ComboBoxItem x:Name="FilterLowShelfItem" Content="Alt Ses Rafı (Bas)" Tag="lowShelving" />
                                            <ComboBoxItem x:Name="FilterHighShelfItem" Content="Üst Ses Rafı (Tiz)" Tag="highShelving" />
                                            <ComboBoxItem x:Name="FilterLowPassItem" Content="Alçak Geçiren" Tag="lowPass" />
                                            <ComboBoxItem x:Name="FilterHighPassItem" Content="Yüksek Geçiren" Tag="highPass" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3: DSP / AUDIO EFFECTS -->
                    <StackPanel x:Name="DspTabPanel" Visibility="Collapsed">
                        <!-- Channel Selector -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Margin="0,0,0,8">
                            <UniformGrid x:Name="DspChannelSelectorGrid" Rows="1">
                                <RadioButton GroupName="DspChannelGroup" Content="Game" Tag="game" Style="{StaticResource SegmentedRadioStyle}" IsChecked="True" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="DspChannelGroup" Content="Chat" Tag="chatRender" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="DspChannelGroup" Content="Media" Tag="media" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="DspChannelGroup" Content="Aux" Tag="aux" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                                <RadioButton GroupName="DspChannelGroup" Content="Mic" Tag="chatCapture" Style="{StaticResource SegmentedRadioStyle}" Checked="AdvancedChannel_Checked" />
                            </UniformGrid>
                        </Border>

                        <!-- Active Profile Header & Full Reset -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_ActivePresetLabel}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,0,6,0" />
                                    <TextBlock x:Name="DspActivePresetLabel"
                                               Text="Custom"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="#FF7A33" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource Str_ResetFullPresetBtn}"
                                        Style="{StaticResource ActionChipButtonStyle}"
                                        ToolTip="{DynamicResource Str_ResetFullPresetTooltip}"
                                        Click="ResetActiveChannelProfile_Click" />
                            </Grid>
                        </Border>

                        <!-- Render Channels DSP (Game / Media / Aux) -->
                        <StackPanel x:Name="RenderDspPanel">
                            <!-- Spatial Audio -->
                            <Border Background="{StaticResource CardBgBrush}"
                                    BorderBrush="#323238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SpatialToggle"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource Str_SpatialAudio}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="DspControl_Changed" />
                                        <ComboBox x:Name="FormFactorCombo"
                                                  Grid.Column="1"
                                                  Width="96"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="DspCombo_SelectionChanged"
                                                  DropDownOpened="ComboBox_DropDownOpened"
                                                  DropDownClosed="ComboBox_DropDownClosed"
                                                  Margin="6,0,0,0">
                                            <ComboBoxItem x:Name="FormFactorHeadphonesItem" Content="Kulaklık" Tag="headphones" />
                                            <ComboBoxItem x:Name="FormFactorSpeakersItem" Content="Hoparlör" Tag="speakers" />
                                        </ComboBox>
                                        <Button Grid.Column="2"
                                                Tag="spatial"
                                                Style="{StaticResource ResetIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_DspSingleResetTooltip}"
                                                Click="ResetSingleEffect_Click"
                                                Margin="6,0,0,0" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_ReverbDistance}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="ReverbSlider" Grid.Column="1" Tag="spatial" Minimum="-12" Maximum="0" TickFrequency="0.5" SmallChange="0.5" LargeChange="1" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="ReverbValueText" Grid.Column="2" Text="-6.0 dB" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Tone Boosters & General Gain -->
                            <Border Background="{StaticResource CardBgBrush}"
                                    BorderBrush="#323238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="164" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="BassBoostToggle" Grid.Column="0" Content="{DynamicResource Str_BassBoost}" Style="{StaticResource ToggleSwitchStyle}" Click="DspControl_Changed" />
                                        <Slider x:Name="BassBoostSlider" Grid.Column="1" Tag="bassBoost" Minimum="-12" Maximum="12" TickFrequency="0.2" SmallChange="0.5" LargeChange="1" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="BassBoostValueText" Grid.Column="2" Text="0.0 dB" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Tag="bassBoost" Style="{StaticResource ResetIconButtonStyle}" ToolTip="{DynamicResource Str_DspSingleResetTooltip}" Click="ResetSingleEffect_Click" Margin="6,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="164" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="TrebleBoostToggle" Grid.Column="0" Content="{DynamicResource Str_TrebleBoost}" Style="{StaticResource ToggleSwitchStyle}" Click="DspControl_Changed" />
                                        <Slider x:Name="TrebleBoostSlider" Grid.Column="1" Tag="trebleBoost" Minimum="-12" Maximum="12" TickFrequency="0.2" SmallChange="0.5" LargeChange="1" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="TrebleBoostValueText" Grid.Column="2" Text="0.0 dB" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Tag="trebleBoost" Style="{StaticResource ResetIconButtonStyle}" ToolTip="{DynamicResource Str_DspSingleResetTooltip}" Click="ResetSingleEffect_Click" Margin="6,0,0,0" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="164" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="VoiceClarityToggle" Grid.Column="0" Content="{DynamicResource Str_VoiceClarity}" Style="{StaticResource ToggleSwitchStyle}" Click="DspControl_Changed" />
                                        <Slider x:Name="VoiceClaritySlider" Grid.Column="1" Tag="voiceClarity" Minimum="-12" Maximum="12" TickFrequency="0.2" SmallChange="0.5" LargeChange="1" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="VoiceClarityValueText" Grid.Column="2" Text="0.0 dB" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Tag="voiceClarity" Style="{StaticResource ResetIconButtonStyle}" ToolTip="{DynamicResource Str_DspSingleResetTooltip}" Click="ResetSingleEffect_Click" Margin="6,0,0,0" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="164" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_GeneralGain}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="39,0,0,0" />
                                        <Slider x:Name="GeneralGainSlider" Grid.Column="1" Tag="generalGain" Minimum="0" Maximum="12" TickFrequency="0.1" SmallChange="0.5" LargeChange="1" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="GeneralGainValueText" Grid.Column="2" Text="0.0 dB" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Button Grid.Column="3" Tag="generalGain" Style="{StaticResource ResetIconButtonStyle}" ToolTip="{DynamicResource Str_DspSingleResetTooltip}" Click="ResetSingleEffect_Click" Margin="6,0,0,0" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Smart Volume -->
                            <Border Background="{StaticResource CardBgBrush}"
                                    BorderBrush="#323238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="SmartVolumeToggle"
                                                  Grid.Column="0"
                                                  Content="{DynamicResource Str_SmartVolume}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="DspControl_Changed" />
                                        <ComboBox x:Name="SmartVolumeLoudnessCombo"
                                                  Grid.Column="1"
                                                  Width="105"
                                                  Style="{StaticResource DarkComboBoxStyle}"
                                                  SelectedValuePath="Tag"
                                                  SelectionChanged="DspCombo_SelectionChanged"
                                                  DropDownOpened="ComboBox_DropDownOpened"
                                                  DropDownClosed="ComboBox_DropDownClosed">
                                            <ComboBoxItem x:Name="LoudnessSoftItem" Content="Yumuşak" Tag="soft" />
                                            <ComboBoxItem x:Name="LoudnessBalancedItem" Content="Dengeli" Tag="balanced" />
                                            <ComboBoxItem x:Name="LoudnessExtremeItem" Content="Güçlü" Tag="extreme" />
                                        </ComboBox>
                                        <Button Grid.Column="2"
                                                Tag="smartVolume"
                                                Style="{StaticResource ResetIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_DspSingleResetTooltip}"
                                                Click="ResetSingleEffect_Click"
                                                Margin="6,0,0,0" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_SmartVolumeLevel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="SmartVolumeSlider" Grid.Column="1" Tag="smartVolume" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.02" LargeChange="0.1" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="SmartVolumeValueText" Grid.Column="2" Text="0.00" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Voice / Mic Channels DSP (Chat / Mic) -->
                        <StackPanel x:Name="VoiceDspPanel" Visibility="Collapsed">
                            <!-- 1. ClearCast AI Noise Cancellation -->
                            <Border Background="{StaticResource CardBgBrush}"
                                    BorderBrush="#323238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <CheckBox x:Name="AiNoiseCancelToggle"
                                                  Content="{DynamicResource Str_AiNoiseCancel}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="DspControl_Changed"
                                                  HorizontalAlignment="Left" />
                                        <Button Tag="aiNoise"
                                                Style="{StaticResource ResetIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_DspSingleResetTooltip}"
                                                Click="ResetSingleEffect_Click"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_AiNoiseStrength}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="AiNoiseCancelSlider" Grid.Column="1" Tag="aiNoise" Minimum="0" Maximum="100" TickFrequency="1" SmallChange="1" LargeChange="5" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="AiNoiseCancelValueText" Grid.Column="2" Text="50" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. Noise Reduction (Background & Impact) -->
                            <Border Background="{StaticResource CardBgBrush}"
                                    BorderBrush="#323238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{DynamicResource Str_NoiseReductionTitle}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Left" />
                                        <Button Tag="noiseReductionAll"
                                                Style="{StaticResource ResetIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_DspSingleResetTooltip}"
                                                Click="ResetSingleEffect_Click"
                                                HorizontalAlignment="Right" />
                                    </Grid>

                                    <TextBlock x:Name="NoiseReductionDisabledHint"
                                               Text="{DynamicResource Str_NoiseReductionDisabledHint}"
                                               FontSize="10.5"
                                               Foreground="#F59E0B"
                                               Margin="0,0,0,6"
                                               Visibility="Collapsed" />

                                    <StackPanel x:Name="NoiseReductionControlsPanel">
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="NoiseReductionToggle" Grid.Column="0" Content="{DynamicResource Str_NoiseReductionBg}" Style="{StaticResource ToggleSwitchStyle}" Click="DspControl_Changed" />
                                            <Slider x:Name="NoiseReductionSlider" Grid.Column="1" Tag="noiseReduction" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                            <TextBlock x:Name="NoiseReductionValueText" Grid.Column="2" Text="0.00" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Tag="noiseReduction" Style="{StaticResource ResetIconButtonStyle}" ToolTip="{DynamicResource Str_DspSingleResetTooltip}" Click="ResetSingleEffect_Click" Margin="6,0,0,0" />
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="164" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ImpactNoiseToggle" Grid.Column="0" Content="{DynamicResource Str_NoiseReductionImpact}" Style="{StaticResource ToggleSwitchStyle}" Click="DspControl_Changed" />
                                            <Slider x:Name="ImpactNoiseSlider" Grid.Column="1" Tag="impactNoise" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                            <TextBlock x:Name="ImpactNoiseValueText" Grid.Column="2" Text="0.00" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Tag="impactNoise" Style="{StaticResource ResetIconButtonStyle}" ToolTip="{DynamicResource Str_DspSingleResetTooltip}" Click="ResetSingleEffect_Click" Margin="6,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 3. Noise Gate -->
                            <Border Background="{StaticResource CardBgBrush}"
                                    BorderBrush="#323238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <CheckBox x:Name="NoiseGateToggle"
                                                  Content="{DynamicResource Str_NoiseGate}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="DspControl_Changed"
                                                  HorizontalAlignment="Left" />
                                        <Button Tag="noiseGate"
                                                Style="{StaticResource ResetIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_DspSingleResetTooltip}"
                                                Click="ResetSingleEffect_Click"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_NoiseGateThreshold}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="NoiseGateSlider" Grid.Column="1" Tag="noiseGate" Minimum="-60" Maximum="-10" TickFrequency="0.1" SmallChange="0.5" LargeChange="2" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="NoiseGateValueText" Grid.Column="2" Text="-60.0 dB" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <CheckBox x:Name="AutoNoiseGateToggle"
                                              Content="{DynamicResource Str_AutoNoiseGate}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Click="DspControl_Changed" />
                                </StackPanel>
                            </Border>

                            <!-- 4. Compressor (Volume Stabilizer) -->
                            <Border Background="{StaticResource CardBgBrush}"
                                    BorderBrush="#323238"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <CheckBox x:Name="VolumeStabilizerToggle"
                                                  Content="{DynamicResource Str_VolumeStabilizer}"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  Click="DspControl_Changed"
                                                  HorizontalAlignment="Left" />
                                        <Button Tag="volumeStabilizer"
                                                Style="{StaticResource ResetIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_DspSingleResetTooltip}"
                                                Click="ResetSingleEffect_Click"
                                                HorizontalAlignment="Right" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_VolumeStabilizerLevel}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <Slider x:Name="VolumeStabilizerSlider" Grid.Column="1" Tag="volumeStabilizer" Minimum="0" Maximum="1" TickFrequency="0.01" SmallChange="0.01" LargeChange="0.05" Style="{StaticResource HorizontalAccentSliderStyle}" ValueChanged="DspSlider_ValueChanged" PreviewMouseLeftButtonDown="DspSlider_PreviewMouseLeftButtonDown" ToolTip="{DynamicResource Str_DspSliderResetTooltip}" Margin="6,0" />
                                        <TextBlock x:Name="VolumeStabilizerValueText" Grid.Column="2" Text="0.40" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- SETTINGS PANEL -->
                    <StackPanel x:Name="SettingsTabPanel" Visibility="Collapsed">
                        <!-- Settings Header Row -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="{DynamicResource Str_SettingsTitle}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left" />
                                <Button Content="{DynamicResource Str_SettingsBackBtn}"
                                        Style="{StaticResource ActionChipButtonStyle}"
                                        Click="CloseSettingsButton_Click"
                                        HorizontalAlignment="Right"
                                        Padding="9,3" />
                            </Grid>
                        </Border>

                        <!-- Startup Settings Card -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_SettingsStartupHeader}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FF7A33"
                                           Margin="0,0,0,8" />

                                <CheckBox x:Name="RunAtStartupToggle"
                                          Content="{DynamicResource Str_SettingsRunAtStartup}"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Click="RunAtStartupToggle_Click" />
                                <TextBlock Text="{DynamicResource Str_SettingsRunAtStartupDesc}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="39,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Language Selection Card -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_SettingsLanguageHeader}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FF7A33"
                                           Margin="0,0,0,8" />
                                <Border Background="#1B1B20"
                                        BorderBrush="#323238"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="3">
                                    <UniformGrid Rows="1" Columns="2">
                                        <RadioButton x:Name="LangTrRadio"
                                                     GroupName="SettingsLangGroup"
                                                     Content="Türkçe"
                                                     Style="{StaticResource SegmentedRadioStyle}"
                                                     Click="LangRadio_Click" />
                                        <RadioButton x:Name="LangEnRadio"
                                                     GroupName="SettingsLangGroup"
                                                     Content="English"
                                                     Style="{StaticResource SegmentedRadioStyle}"
                                                     Click="LangRadio_Click" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Sonar Audio Engine Card -->
                        <Border Background="{StaticResource CardBgBrush}"
                                BorderBrush="#323238"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_SettingsEngineHeader}"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="#FF7A33"
                                           Margin="0,0,0,4" />
                                <TextBlock Text="{DynamicResource Str_SettingsEngineDesc}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <Button x:Name="RestartEngineButton"
                                        Content="{DynamicResource Str_SettingsRestartEngineBtn}"
                                        Style="{StaticResource ActionChipButtonStyle}"
                                        Click="RestartEngineButton_Click"
                                        HorizontalAlignment="Stretch"
                                        Padding="10,7" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Loading / Connecting Lock Overlay -->
            <Border x:Name="LoadingOverlayBorder"
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Background="#18181B"
                    CornerRadius="8"
                    Padding="24,48"
                    Visibility="Visible"
                    Panel.ZIndex="10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="11"
                            Background="#FF5500"
                            HorizontalAlignment="Center">
                        <Control Template="{StaticResource SonarLogoTemplate}" Margin="6" Focusable="False" />
                    </Border>

                    <TextBlock Text="{DynamicResource Str_LoadingTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,6" />

                    <TextBlock Text="{DynamicResource Str_LoadingSubtitle}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,18" />

                    <ProgressBar IsIndeterminate="True"
                                 Height="4"
                                 Width="180"
                                 Background="#27272A"
                                 Foreground="#FF5500"
                                 BorderThickness="0"
                                 HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
